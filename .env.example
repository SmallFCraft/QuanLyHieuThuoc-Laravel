APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS does nothing on Windows: `artisan serve` prints
# "forking is not supported on this platform" and pcntl_fork is unavailable, so the
# dev server handles ONE request at a time no matter what this is set to.
# For real concurrency use Apache/nginx + PHP-FPM, or Laravel Octane.

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `daily` keeps the file rotating: one INFO line per AI provider call adds up, and a
# single unrotated laravel.log cannot be truncated on Windows while a worker holds it.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_TIMEZONE=+07:00
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chatbot AI Provider Configuration
# AI_API_MODE: chat_completions | responses | anthropic_messages
AI_API_MODE=chat_completions
AI_BASE_URL=http://localhost:55597/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4096
# Overall request budget for a provider call, and the connect phase alone.
AI_TIMEOUT=20
AI_CONNECT_TIMEOUT=5
# Answer the question typed alongside an uploaded image.
AI_IMAGE_ANSWER=true
# anthropic_messages mode only; ignored by the other modes.
AI_ANTHROPIC_VERSION=2023-06-01
AI_THINKING=disabled

# Health triage ("Sàng lọc") AI seams. On by default — set to false only as a kill
# switch. Each seam degrades to the rule-engine result when the provider is down.
AI_TRIAGE_FACTS=true
AI_TRIAGE_CLARIFY=true
AI_TRIAGE_ADVICE=true
AI_TRIAGE_DRAFT=true
AI_TRIAGE_BRIEFING=true
# Runs inside a synchronous form POST, so it must stay well below AI_TIMEOUT — but real
# providers answer the same prompt in 2s one hour and 30s the next, so do not size this
# for the fast case.
AI_TRIAGE_TIMEOUT=30
# The advice rewrite always runs in a worker, so it can wait longer than the wizard can.
AI_TRIAGE_ADVICE_TIMEOUT=45
# The briefing runs in a worker after the outcome is final, so it may take its time.
AI_TRIAGE_BRIEFING_TIMEOUT=90

# Optional fallback provider, used when the primary one fails.
# Example for Anthropic: base_url https://api.anthropic.com/v1, model claude-sonnet-5
AI_FALLBACK_API_MODE=anthropic_messages
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Slower/pricier fallback models can get their own budget (defaults to AI_TIMEOUT)
AI_FALLBACK_TIMEOUT=
