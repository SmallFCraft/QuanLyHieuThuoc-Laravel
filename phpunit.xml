<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_TIMEZONE" value="Asia/Ho_Chi_Minh"/>
        <env name="DB_TIMEZONE" value="+07:00"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- No test reads the log file, and the suite exercises the failure branches on
             purpose ("smtp down", "gateway down"), so its output would otherwise bury
             the real entries in storage/logs/laravel.log. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Pin the chatbot AI provider so tests never depend on the local .env -->
        <env name="AI_API_MODE" value="chat_completions"/>
        <env name="AI_BASE_URL" value="http://localhost:55597/v1"/>
        <env name="AI_API_KEY" value="agt_codex_test"/>
        <env name="AI_MODEL" value="test-model"/>
        <env name="AI_MAX_TOKENS" value="2048"/>
        <env name="AI_FALLBACK_BASE_URL" value=""/>
        <env name="AI_FALLBACK_API_KEY" value=""/>
        <env name="AI_FALLBACK_MODEL" value=""/>
        <!-- Off by default so image tests assert the deterministic summary; the
             tests that cover the AI answer enable it explicitly. -->
        <env name="AI_IMAGE_ANSWER" value="false"/>
        <!-- Triage AI off by default. Http::preventStrayRequests() is not used in the
             existing suites, so an un-faked call would connect to the pinned base URL,
             throw, and be swallowed by the degrade path — a green test exercising the
             failure branch. The AI triage tests enable these explicitly. -->
        <env name="AI_TRIAGE_FACTS" value="false"/>
        <env name="AI_TRIAGE_CLARIFY" value="false"/>
        <env name="AI_TRIAGE_ADVICE" value="false"/>
        <env name="AI_TRIAGE_DRAFT" value="false"/>
        <env name="AI_TRIAGE_BRIEFING" value="false"/>
        <env name="AI_TRIAGE_TIMEOUT" value="8"/>
        <env name="AI_TRIAGE_ADVICE_TIMEOUT" value="8"/>
    </php>
</phpunit>
